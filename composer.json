{
    "name": "knox4/virtual-motors",
    "description": "Virtual Motors e-commerce application built with PHP.",
    "require": {
        "phpmailer/phpmailer": "^7.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Knox4\\VirtualMotors\\": "src/"
        }
    },
    "authors": [
        {
            "name": "RayRay",
            "email": "selau.gu45@gmail.com"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "phpcs": "@php vendor/bin/phpcs --standard=phpcs.xml"
    }
}
