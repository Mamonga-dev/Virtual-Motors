### AL ###
# Template for AL projects for Dynamics 365 Business Central
# launch.json folder
.vscode/
# Cache folder
.alcache/
# Symbols folder
.alpackages/
# Snapshots folder
.snapshots/
# Testing Output folder
.output/
# Extension App-file
*.app
# Rapid Application Development File
rad.json
# Translation Base-file
*.g.xlf
# License-files
*.bclicense
*.flf
# Test results file
TestResults.xml

### Virtual Motors ###
# Configuração do VS Code (inclui .vscode/sftp.json, com a senha do FTP)
# Já coberto pela linha ".vscode/" acima, mantido aqui por segurança
.vscode/sftp.json

# Credenciais do banco de produção (InfinityFree)
# Cada computador cria o seu; nunca vai pro GitHub
/config/*.php
!/config/*.example
# Arquivos antigos na raiz permanecem ignorados por segurança
/config.producao.php
/database.config.php
/email-test.config.php
/vendor/
/var/email-test/

composer.phar
# Variáveis e segredos de ambiente (mantenha exemplos versionados)
.env
.env.*
!.env.example
!.env.*.example
